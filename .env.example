# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่องที่ใช้งาน
# ค่าที่ตั้งใน environment จริงจะชนะค่าในไฟล์นี้เสมอ
# ⚠️ ห้าม commit ไฟล์ .env เข้า git เด็ดขาด

# ===========================================================================
# ฐานข้อมูล
# ===========================================================================
# ตั้ง DATABASE_URL = ใช้ PostgreSQL
# ไม่ตั้ง            = ใช้ SQLite ตาม SQLITE_PATH (สำหรับพัฒนาบนเครื่องตัวเอง)
#
# ตอนรันด้วย docker compose ไม่ต้องตั้งค่านี้เอง
# เพราะ compose ประกอบ DATABASE_URL ให้จาก POSTGRES_* ข้างล่างอยู่แล้ว
#
# ถ้าจะต่อ PostgreSQL จากเครื่อง dev ตรง ๆ:
#   DATABASE_URL=postgres://sip_user:yourpassword@127.0.0.1:5432/sip_plan_db
# DATABASE_URL=

# --- ใช้ตอนรันด้วย docker compose ---
POSTGRES_DB=sip_plan_db
POSTGRES_USER=sip_user
# ⚠️ บังคับต้องตั้ง ไม่มีค่าเริ่มต้นให้ compose จะไม่ยอมสตาร์ทถ้าเว้นว่าง
#    สร้างรหัสผ่านสุ่มด้วย (ตัวอักษรและตัวเลขล้วน):
#      LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32; echo
#    ห้ามมี @ : / # ปนอยู่ เพราะรหัสนี้ถูกประกอบเข้าไปใน DATABASE_URL
POSTGRES_PASSWORD=

# พอร์ตที่เปิดออกจาก NAS (DSM ใช้ 5000/5001 อยู่แล้ว เลี่ยงเลขซ้ำ)
WEB_PORT=8000

# จำนวน worker ของ gunicorn — สูตรคร่าว ๆ (2 x จำนวน core) + 1
# บน NAS ที่แรมจำกัดอย่าตั้งเกิน 4
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# --- ใช้เฉพาะตอนพัฒนาบนเครื่อง (ไม่ได้ตั้ง DATABASE_URL) ---
# สำคัญ: ต้องอยู่นอกโฟลเดอร์ cloud sync (Synology Drive/Dropbox/iCloud)
# มิฉะนั้นตัว sync จะทำไฟล์ฐานข้อมูลพังได้
SQLITE_PATH=/absolute/path/outside/sync/db.sqlite3

# ===========================================================================
# Django
# ===========================================================================
# production: สร้างใหม่ด้วย
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 50; echo
#
# ⚠️ ใช้คำสั่งข้างบน อย่าใช้ get_random_secret_key() ของ Django ตรง ๆ
#    เพราะมันใส่อักขระอย่าง & # $ ( ) มาด้วย ซึ่งทำให้ไฟล์ .env
#    ถูกตีความผิดเวลา shell script อ่าน ตัวอักษรและตัวเลขล้วน 50 ตัว
#    ให้ความสุ่มมากเกินพอแล้ว
#
# ถ้าไม่ตั้งแล้ว DJANGO_DEBUG=False ระบบจะไม่ยอมสตาร์ท (ตั้งใจให้เป็นแบบนั้น)
DJANGO_SECRET_KEY=

# production ต้องเป็น False เสมอ
DJANGO_DEBUG=True

# production ระบุโดเมนหรือ IP ให้ชัดเจน ห้ามใช้ *
# ถ้าตั้งเป็น * ตอน DEBUG=False ระบบจะไม่ยอมสตาร์ท
# DJANGO_ALLOWED_HOSTS=sipplan.ubu.ac.th,192.168.1.50
DJANGO_ALLOWED_HOSTS=*

# ===========================================================================
# HTTPS (ตั้งเมื่อเข้าใช้งานผ่าน Reverse Proxy ของ DSM เท่านั้น)
# ===========================================================================
# ⚠️ ตั้ง True ก็ต่อเมื่อเข้าผ่าน https จริงแล้วเท่านั้น
#    ถ้ายังเข้าผ่าน http://<ip-ของ-nas>:8000 แล้วตั้ง True
#    คุกกี้จะไม่ถูกส่ง ทำให้ล็อกอินไม่ผ่านทั้งระบบ
DJANGO_SECURE_SSL=False

# ต้องใส่เมื่อเข้าผ่านโดเมนจริง ไม่งั้นส่งฟอร์มแล้วจะติด CSRF
# DJANGO_CSRF_TRUSTED_ORIGINS=https://sipplan.ubu.ac.th

# ===========================================================================
# เข้าสู่ระบบด้วยบัญชี Google (@ubu.ac.th)
# ===========================================================================
# สร้างที่ Google Cloud Console > APIs & Services > Credentials
#   > Create Credentials > OAuth client ID > Web application
# ตั้ง Authorized redirect URI ให้ตรงทุกตัวอักษร (รวมเครื่องหมาย / ท้ายสุด):
#   http://127.0.0.1:8000/accounts/google/login/callback/     (สำหรับพัฒนา)
#   https://<โดเมนจริง>/accounts/google/login/callback/        (สำหรับใช้งานจริง)
# แนะนำให้ตั้ง OAuth consent screen เป็น "Internal" ของ ubu.ac.th
# เพราะ Google จะปฏิเสธบัญชีนอกองค์กรให้ตั้งแต่ต้นทาง
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# โดเมนอีเมลที่อนุญาต (ไม่ต้องใส่เครื่องหมาย @)
GOOGLE_ALLOWED_DOMAIN=ubu.ac.th

# True  = ผู้ใช้ @ubu.ac.th ที่ยังไม่มีบัญชี จะถูกสร้างให้อัตโนมัติเมื่อเข้าครั้งแรก
# False = ต้องให้ผู้ดูแลระบบสร้างบัญชีไว้ก่อน จึงจะผูกกับ Google ได้
GOOGLE_AUTO_PROVISION=True

# ระบบไม่ได้ตั้งค่า SMTP ไว้ จึงใช้ console backend เป็นค่าเริ่มต้น
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
